SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=development
SERVER_PUBLIC_URL=http://localhost:8080

POSTGRES_DB=plystra
POSTGRES_USER=plystra
POSTGRES_PASSWORD=plystra
POSTGRES_PORT=5432
DATABASE_URL=postgres://plystra:plystra@localhost:5432/plystra?sslmode=disable
DOCKER_DATABASE_URL=postgres://plystra:plystra@postgres:5432/plystra?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=30m

LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
TRUSTED_PROXIES=

AUDIT_WRITE_MODE=always
TRACE_VERSION=1.0

PLYSTRA_SESSION_SECRET=change-me-session-secret-at-least-32-characters
# Compatibility alias for deployments that already use JWT_SECRET.
JWT_SECRET=change-me-to-at-least-32-characters
PLYSTRA_ADMIN_TOKEN=change-me-admin-token-at-least-32-characters
JWT_ISSUER=plystra-core
ACCESS_TOKEN_TTL=1h

DATA_CONSOLE_ENABLED=false
METRICS_ENABLED=false
METRICS_TOKEN=

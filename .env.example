SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=development
SERVER_PUBLIC_URL=http://localhost:8080

POSTGRES_DB=plystra
POSTGRES_USER=plystra
POSTGRES_PASSWORD=plystra
POSTGRES_PORT=5432
DATABASE_URL=postgres://plystra:plystra@localhost:5432/plystra?sslmode=disable
DOCKER_DATABASE_URL=postgres://plystra:plystra@postgres:5432/plystra?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=30m

LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
TRUSTED_PROXIES=

AUDIT_WRITE_MODE=always
TRACE_VERSION=1.0

PLYSTRA_SESSION_SECRET=change-me-session-secret-at-least-32-characters
PLYSTRA_API_KEY_SECRET=change-me-api-key-secret-at-least-32-characters
PLYSTRA_AUTH_PUBLIC_USER_REGISTRATION_ENABLED=false

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s

DATA_CONSOLE_ENABLED=false
METRICS_ENABLED=false
METRICS_TOKEN=

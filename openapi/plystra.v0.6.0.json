{
  "openapi": "3.1.0",
  "info": {
    "title": "Plystra Core API",
    "version": "0.6.0-dev",
    "description": "Pre-1.0 Plystra Core API contract for system, authorization, audit, resource registry, and plugin metadata."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/api/v1/system/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is alive"
          }
        }
      }
    },
    "/api/v1/system/ready": {
      "get": {
        "summary": "Readiness check",
        "responses": {
          "200": {
            "description": "Service is ready"
          },
          "503": {
            "description": "Service is not ready"
          }
        }
      }
    },
    "/api/v1/system/version": {
      "get": {
        "summary": "Version metadata",
        "responses": {
          "200": {
            "description": "Core version and compatibility metadata"
          }
        }
      }
    },
    "/api/v1/console/overview": {
      "get": {
        "summary": "Console overview counts and recent audit logs",
        "responses": {
          "200": {
            "description": "Overview data"
          }
        }
      }
    },
    "/api/v1/authz/check": {
      "post": {
        "summary": "Run a compact authorization check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthzCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization decision"
          }
        }
      }
    },
    "/api/v1/authz/explain": {
      "post": {
        "summary": "Run an authorization check and return the full trace",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthzCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full authorization trace"
          }
        }
      }
    },
    "/api/v1/audit/logs": {
      "get": {
        "summary": "List audit logs",
        "parameters": [
          {"name": "space_id", "in": "query", "schema": {"type": "string"}},
          {"name": "decision", "in": "query", "schema": {"type": "string"}},
          {"name": "deny_code", "in": "query", "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {
            "description": "Audit log list"
          }
        }
      }
    },
    "/api/v1/audit/logs/{audit_log_id}": {
      "get": {
        "summary": "Get an audit log",
        "parameters": [
          {"name": "audit_log_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Audit log detail"},
          "404": {"description": "Audit log not found"}
        }
      }
    },
    "/api/v1/resource-types": {
      "get": {
        "summary": "List ResourceTypes",
        "responses": {
          "200": {"description": "ResourceType list"}
        }
      }
    },
    "/api/v1/resource-types/{key}": {
      "get": {
        "summary": "Get a ResourceType",
        "parameters": [
          {"name": "key", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "ResourceType detail"}
        }
      }
    },
    "/api/v1/resource-types/{key}/actions": {
      "get": {
        "summary": "List ResourceActions for a ResourceType",
        "parameters": [
          {"name": "key", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "ResourceAction list"}
        }
      }
    },
    "/api/v1/resource-types/{key}/mapping": {
      "get": {
        "summary": "Get ResourceMapping for a ResourceType",
        "parameters": [
          {"name": "key", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "ResourceMapping detail"}
        }
      }
    },
    "/api/v1/plugins": {
      "get": {
        "summary": "List installed plugin metadata",
        "responses": {
          "200": {"description": "Plugin list"}
        }
      }
    },
    "/api/v1/plugins/{plugin_id}": {
      "get": {
        "summary": "Get plugin metadata",
        "parameters": [
          {"name": "plugin_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Plugin detail"}
        }
      }
    },
    "/api/v1/plugins/install": {
      "post": {
        "summary": "Install or update plugin metadata",
        "responses": {
          "201": {"description": "Installed plugin metadata"}
        }
      }
    },
    "/api/v1/plugins/{plugin_id}/enable": {
      "post": {
        "summary": "Enable a plugin",
        "parameters": [
          {"name": "plugin_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Updated plugin metadata"}
        }
      }
    },
    "/api/v1/plugins/{plugin_id}/disable": {
      "post": {
        "summary": "Disable a plugin",
        "parameters": [
          {"name": "plugin_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Updated plugin metadata"}
        }
      }
    },
    "/api/v1/plugins/{plugin_id}/settings": {
      "get": {
        "summary": "List plugin settings",
        "parameters": [
          {"name": "plugin_id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "space_id", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Plugin setting list"}
        }
      },
      "patch": {
        "summary": "Update plugin settings",
        "parameters": [
          {"name": "plugin_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Updated plugin setting list"}
        }
      }
    },
    "/api/v1/plugins/validate-manifest": {
      "post": {
        "summary": "Validate a plugin manifest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PluginManifest"
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Validation result"}
        }
      }
    },
    "/api/v1/templates": {
      "get": {
        "summary": "List templates",
        "responses": {
          "200": {"description": "Template list"}
        }
      }
    },
    "/api/v1/templates/{template_id}": {
      "get": {
        "summary": "Get a template",
        "parameters": [
          {"name": "template_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Template detail"}
        }
      }
    },
    "/api/v1/templates/{template_id}/preview-install": {
      "post": {
        "summary": "Preview template installation",
        "parameters": [
          {"name": "template_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Template installation preview"}
        }
      }
    },
    "/api/v1/templates/{template_id}/install": {
      "post": {
        "summary": "Record template installation",
        "parameters": [
          {"name": "template_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "201": {"description": "Template installation record"}
        }
      }
    },
    "/api/v1/data/tables": {
      "get": {
        "summary": "List data table mappings",
        "responses": {
          "200": {"description": "Data table mapping list"}
        }
      }
    },
    "/api/v1/data/rows/{resource_type}": {
      "get": {
        "summary": "List rows for a mapped resource type",
        "parameters": [
          {"name": "resource_type", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "space_id", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Data row list"}
        }
      },
      "post": {
        "summary": "Create a data row after authorization",
        "parameters": [
          {"name": "resource_type", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "201": {"description": "Created data row and authorization decision"},
          "403": {"description": "Authorization denied"}
        }
      }
    },
    "/api/v1/data/rows/{resource_type}/{resource_id}": {
      "get": {
        "summary": "Get a mapped data row",
        "parameters": [
          {"name": "resource_type", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "resource_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Data row detail"}
        }
      },
      "patch": {
        "summary": "Update a data row after authorization",
        "parameters": [
          {"name": "resource_type", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "resource_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Updated data row and authorization decision"},
          "403": {"description": "Authorization denied"}
        }
      },
      "delete": {
        "summary": "Soft-delete a data row after authorization",
        "parameters": [
          {"name": "resource_type", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "resource_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Soft-deleted data row and authorization decision"},
          "403": {"description": "Authorization denied"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "data": {},
          "meta": {
            "type": "object",
            "properties": {
              "request_id": {"type": "string"}
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"},
              "details": {},
              "request_id": {"type": "string"}
            },
            "required": ["code", "message", "request_id"]
          }
        }
      },
      "ActorContext": {
        "type": "object",
        "properties": {
          "user_id": {"type": "string"},
          "space_id": {"type": "string"},
          "member_id": {"type": "string"},
          "user_member_id": {"type": "string"}
        },
        "required": ["user_id", "space_id", "member_id", "user_member_id"]
      },
      "AuthzCheckRequest": {
        "type": "object",
        "properties": {
          "actor": {"$ref": "#/components/schemas/ActorContext"},
          "resource_type": {"type": "string"},
          "resource_id": {"type": "string"},
          "action": {"type": "string"},
          "explain": {"type": "boolean"}
        },
        "required": ["actor", "resource_type", "resource_id", "action"]
      },
      "PluginManifest": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "version": {"type": "string"},
          "manifest_version": {"type": "string", "enum": ["0.1", "1.0"]},
          "plugin_api_version": {"type": "string", "enum": ["0.1", "1.0"]},
          "requires_core": {"type": "string"},
          "resources": {"type": "array"},
          "permissions": {"type": "array"},
          "audit_events": {"type": "array"},
          "admin_menu": {"type": "array"},
          "settings": {"type": "array"}
        },
        "required": ["id", "name", "version", "manifest_version", "plugin_api_version", "requires_core"]
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "Plystra Core API",
    "version": "1.0.0",
    "description": "Stable self-hosted Plystra Core API for identity, authorization, resources, and audit."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "components": {
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "data": {},
          "request_id": {
            "type": "string"
          },
          "meta": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {},
              "request_id": {
                "type": "string"
              },
              "deny_code": {
                "type": "string"
              },
              "trace_id": {
                "type": "string"
              },
              "audit_log_id": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string"
          },
          "meta": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "AuthzCheckResponse": {
        "type": "object",
        "properties": {
          "allow": {
            "type": "boolean"
          },
          "decision": {
            "type": "string",
            "enum": [
              "allow",
              "deny"
            ]
          },
          "deny_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          },
          "audit_log_id": {
            "type": "string"
          },
          "audit": {
            "type": "object"
          }
        }
      },
      "AuthzExplainTrace": {
        "type": "object",
        "properties": {
          "trace_version": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "deny_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor": {
            "type": "object"
          },
          "space": {
            "type": "object"
          },
          "target": {
            "type": "object"
          },
          "matched_candidates": {
            "type": "array"
          },
          "reason": {
            "type": "string"
          },
          "audit": {
            "type": "object"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque-session-token",
        "description": "Required for non-public Core API routes. The session user must hold an active admin grant."
      }
    }
